<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BatterySimulatorGUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="BatterySimulatorGUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/favicons/favicon.ico"
        Title="Volue Battery Simulator"
        Width="1600"
        Height="900"
        Position="100 80">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

	<Grid ShowGridLines="False">

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="1" Grid.Row="0" Background="SlateGray"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="4"
                Padding="10" Margin="10">
           <TextBlock FontSize="36" Name="Title" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground  ="White">Volue Battery Simulator </TextBlock>
            </Border>

        <ScrollViewer Grid.Column="0" Grid.Row="1" Grid.RowSpan="5" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5 0">
                <StackPanel.Styles>
                    <Style Selector="TextBlock.label">
                        <Setter Property="Margin" Value="0 6 0 2"/>
                    </Style>
                    <Style Selector="NumericUpDown">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="FormatString" Value="0.##"/>
                    </Style>
                    <Style Selector="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0 4"/>
                    </Style>
                </StackPanel.Styles>

                <ToggleButton Margin="0 5" Click="Button_OnClick_Run" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Foreground="DarkSlateGray">Start simulation</ToggleButton>
                <ToggleButton Margin="0 5" Click="Button_Restart" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Foreground="DarkSlateGray">Restart</ToggleButton>

                <TextBlock Classes="label">Algorithm</TextBlock>
                <ComboBox SelectedIndex="{Binding SelectedAlgorithmIndex}" HorizontalAlignment="Stretch">
                    <ComboBoxItem>Price policy</ComboBoxItem>
                    <ComboBoxItem>POMA</ComboBoxItem>
                </ComboBox>

                <TextBlock Margin="0 8 0 0" FontSize="11" Foreground="Gray" TextWrapping="Wrap">Planner settings can be changed while running and apply at the next re-plan; the delay applies immediately. Other settings apply on Start/Restart.</TextBlock>

                <Expander Header="Simulation" IsExpanded="True">
                    <StackPanel>
                        <TextBlock Classes="label">Start date</TextBlock>
                        <CalendarDatePicker SelectedDate="{Binding StartDate}" HorizontalAlignment="Stretch"
                                            DisplayDateStart="2018-01-01" DisplayDateEnd="2018-12-31"/>
                        <TextBlock Classes="label">Start hour</TextBlock>
                        <NumericUpDown Value="{Binding StartHour}" Minimum="0" Maximum="23" Increment="1" FormatString="0"/>
                        <TextBlock Classes="label">Duration (h)</TextBlock>
                        <NumericUpDown Value="{Binding DurationHours}" Minimum="1" Maximum="8760" Increment="24" FormatString="0"/>
                        <TextBlock Classes="label">Time step (s)</TextBlock>
                        <NumericUpDown Value="{Binding TimeStepSeconds}" Minimum="60" Maximum="3600" Increment="60" FormatString="0"/>
                        <TextBlock Classes="label">Delay per step (ms)</TextBlock>
                        <NumericUpDown Value="{Binding DelayMilliseconds}" Minimum="0" Maximum="5000" Increment="50" FormatString="0"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Market">
                    <StackPanel>
                        <TextBlock Classes="label">Price area</TextBlock>
                        <ComboBox ItemsSource="{Binding PriceAreas}" SelectedItem="{Binding SelectedPriceArea}" HorizontalAlignment="Stretch"/>
                        <TextBlock Classes="label">Market model</TextBlock>
                        <ComboBox SelectedIndex="{Binding MarketModelIndex}" HorizontalAlignment="Stretch">
                            <ComboBoxItem>Single price</ComboBoxItem>
                            <ComboBoxItem>Order book (intraday)</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Classes="label">Buy/sell spread (€/MWh, single price)</TextBlock>
                        <NumericUpDown Value="{Binding BuySellSpread}" Minimum="0" Maximum="100" Increment="0.5"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Order book">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap">Used when the market model is Order book. 15-minute products; the mid price ends at the realized price at delivery.</TextBlock>
                        <TextBlock Classes="label">Gate closure (min before delivery)</TextBlock>
                        <NumericUpDown Value="{Binding GateClosureMinutes}" Minimum="0" Maximum="240" Increment="5" FormatString="0"/>
                        <TextBlock Classes="label">Mid volatility (€/MWh/√h)</TextBlock>
                        <NumericUpDown Value="{Binding MidVolatility}" Minimum="0" Maximum="100" Increment="0.5"/>
                        <TextBlock Classes="label">Spread near delivery (€/MWh)</TextBlock>
                        <NumericUpDown Value="{Binding SpreadNearDelivery}" Minimum="0" Maximum="100" Increment="0.1"/>
                        <TextBlock Classes="label">Spread far from delivery (€/MWh)</TextBlock>
                        <NumericUpDown Value="{Binding SpreadFarFromDelivery}" Minimum="0" Maximum="100" Increment="0.5"/>
                        <TextBlock Classes="label">Liquidity build-up time (h)</TextBlock>
                        <NumericUpDown Value="{Binding LiquidityBuildUpHours}" Minimum="0.25" Maximum="48" Increment="1"/>
                        <TextBlock Classes="label">Levels per side</TextBlock>
                        <NumericUpDown Value="{Binding BookLevels}" Minimum="1" Maximum="50" Increment="1" FormatString="0"/>
                        <TextBlock Classes="label">Level price step (€/MWh)</TextBlock>
                        <NumericUpDown Value="{Binding LevelPriceStep}" Minimum="0" Maximum="50" Increment="0.1"/>
                        <TextBlock Classes="label">Volume per level near delivery (MWh)</TextBlock>
                        <NumericUpDown Value="{Binding LevelVolumeMWh}" Minimum="0.1" Maximum="10000" Increment="0.5"/>
                        <TextBlock Classes="label">Depth far from delivery (%)</TextBlock>
                        <NumericUpDown Value="{Binding FarDepthPercent}" Minimum="0" Maximum="100" Increment="5"/>
                        <TextBlock Classes="label">Liquidity recovery time (min)</TextBlock>
                        <NumericUpDown Value="{Binding LiquidityRecoveryMinutes}" Minimum="1" Maximum="1440" Increment="5" FormatString="0"/>
                        <TextBlock Classes="label">Imbalance penalty (€/MWh)</TextBlock>
                        <NumericUpDown Value="{Binding ImbalancePenalty}" Minimum="0" Maximum="1000" Increment="1"/>
                        <TextBlock Classes="label">Random seed</TextBlock>
                        <NumericUpDown Value="{Binding OrderBookSeed}" Minimum="0" Maximum="1000000" Increment="1" FormatString="0"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Battery">
                    <StackPanel>
                        <TextBlock Classes="label">Power (MW)</TextBlock>
                        <NumericUpDown Value="{Binding PowerMW}" Minimum="0.1" Maximum="1000" Increment="1"/>
                        <TextBlock Classes="label">Energy capacity (MWh)</TextBlock>
                        <NumericUpDown Value="{Binding EnergyMWh}" Minimum="0.1" Maximum="10000" Increment="1"/>
                        <TextBlock Classes="label">Charge efficiency (%)</TextBlock>
                        <NumericUpDown Value="{Binding ChargeEfficiencyPercent}" Minimum="1" Maximum="100" Increment="1"/>
                        <TextBlock Classes="label">Discharge efficiency (%)</TextBlock>
                        <NumericUpDown Value="{Binding DischargeEfficiencyPercent}" Minimum="1" Maximum="100" Increment="1"/>
                        <TextBlock Classes="label">Initial SoC (%)</TextBlock>
                        <NumericUpDown Value="{Binding InitialSoCPercent}" Minimum="0" Maximum="100" Increment="5"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Planner (live)">
                    <StackPanel>
                        <TextBlock Classes="label">Planning horizon (h)</TextBlock>
                        <NumericUpDown Value="{Binding PlanningHorizonHours}" Minimum="0.25" Maximum="48" Increment="1"/>
                        <TextBlock Classes="label">Re-plan interval (min)</TextBlock>
                        <NumericUpDown Value="{Binding ReplanIntervalMinutes}" Minimum="15" Maximum="2880" Increment="15" FormatString="0"/>

                        <TextBlock Classes="label" FontWeight="SemiBold" Margin="0 12 0 2">Price policy</TextBlock>
                        <TextBlock Classes="label">Buy threshold (% above min)</TextBlock>
                        <NumericUpDown Value="{Binding BuyThresholdPercent}" Minimum="0" Maximum="100" Increment="5"/>
                        <TextBlock Classes="label">Sell threshold (% below max)</TextBlock>
                        <NumericUpDown Value="{Binding SellThresholdPercent}" Minimum="0" Maximum="100" Increment="5"/>
                        <TextBlock Classes="label">Look-ahead (h)</TextBlock>
                        <NumericUpDown Value="{Binding LookAheadHours}" Minimum="0.25" Maximum="48" Increment="1"/>

                        <TextBlock Classes="label" FontWeight="SemiBold" Margin="0 12 0 2">POMA</TextBlock>
                        <TextBlock Classes="label">Soft SoC min (%)</TextBlock>
                        <NumericUpDown Value="{Binding SocSoftMinPercent}" Minimum="0" Maximum="100" Increment="5"/>
                        <TextBlock Classes="label">Soft SoC max (%)</TextBlock>
                        <NumericUpDown Value="{Binding SocSoftMaxPercent}" Minimum="0" Maximum="100" Increment="5"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

            
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" >
            <TextBlock  Margin="5 5" HorizontalAlignment ="Left" VerticalAlignment="Center" FontSize="24" FontFamily="Consolas" Text="{Binding SimulationTime, Mode = OneWay}"></TextBlock>
            <TextBlock Margin="15 5" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="24" FontFamily="Consolas">Profit: </TextBlock>
            <TextBlock  Margin="0 5" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="24" FontFamily="Consolas" Text="{Binding CurrentPnL, Mode = OneWay}"></TextBlock>
            <TextBlock Margin="15 5" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="24" FontFamily="Consolas">EFC: </TextBlock>
            <TextBlock  Margin="0 5" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="24" FontFamily="Consolas" Text="{Binding EquivalentCycles, Mode = OneWay}"></TextBlock>
            <TextBlock  Margin="15 5" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="18" FontFamily="Consolas" Text="{Binding ExecutionSummary, Mode = OneWay}"></TextBlock>
            <TextBlock  Margin="15 5" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="18" FontFamily="Consolas" Foreground="Red" Text="{Binding StatusMessage, Mode = OneWay}"></TextBlock>
        </StackPanel>
        <Border Grid.Column="2" Grid.Row="2" Background="White"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="3"
                Padding="10" Margin="10">
            <lvc:CartesianChart 
            x:Name ="batteryEnergy"
            Series="{Binding SoC}"
            XAxes="{Binding timeAxis}"
            YAxes="{Binding SoCAxes}">
        </lvc:CartesianChart>
		</Border>
        <Border Grid.Column="1" Grid.Row="3" Background="White"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="3"
                Padding="10" Margin="10">
            <lvc:CartesianChart
                x:Name ="BatteryCharging"
                Series="{Binding Charging}"
                XAxes="{Binding timeAxis}"
                YAxes="{Binding netChargeAxes}"
                LegendPosition="Top">
            </lvc:CartesianChart>
        </Border>
        <Grid Grid.Column="1" Grid.Row="4" ColumnDefinitions="*,*">
            <Border Grid.Column="0" Background="White"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="3"
                    Padding="10" Margin="10">
                <lvc:CartesianChart
                    x:Name ="positions"
                    Series="{Binding Positions}"
                    XAxes="{Binding timeAxis}"
                    YAxes="{Binding positionAxes}"
                    LegendPosition="Top">
                </lvc:CartesianChart>
            </Border>
            <Border Grid.Column="1" Background="White"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="3"
                    Padding="10" Margin="10">
                <lvc:CartesianChart
                    x:Name ="orderBook"
                    Series="{Binding OrderBook}"
                    XAxes="{Binding bookTimeAxis}"
                    YAxes="{Binding bookAxes}"
                    LegendPosition="Top"
                    EasingFunction="{x:Null}">
                </lvc:CartesianChart>
            </Border>
        </Grid>
        <Border Grid.Column="1" Grid.Row="5" Background="White"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="3"
                Padding="10" Margin="10">
            <lvc:CartesianChart
                x:Name ="pnl"
                Series="{Binding PnlSeries}"
                XAxes="{Binding timeAxis}"
                YAxes="{Binding pnlAxes}">
            </lvc:CartesianChart>
        </Border>
    </Grid>
</Window>
